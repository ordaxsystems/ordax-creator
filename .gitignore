# Reproducible outputs are generated by CI, never source authority.
out/
dist/
build/
coverage/
*.test
*.test.exe

# Do not commit OS-generated physical or private signing material.
*.raw
*.raw.gz
*.img
*.img.gz
*.pfx
*.p12
*.pem
*.key
*.private
*.secret
.env
.env.*
!.env.example

# Contract materialization is CI-temporary, not a second OS manifest.
.os-contracts/
.tmp/
.cache/
